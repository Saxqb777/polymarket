# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Market Data ────────────────────────────────────────────────────────────────
POLYGON_API_KEY=
FINNHUB_API_KEY=

# ── News ───────────────────────────────────────────────────────────────────────
NEWSAPI_KEY=
MARKETAUX_API_KEY=

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # your personal chat ID or @channelname

# ── Trading Parameters ─────────────────────────────────────────────────────────
ACCOUNT_CAPITAL=250          # USD — your actual trading capital
RISK_PER_TRADE_PCT=0.01      # 1% risk per trade (= $2.50 on a $250 account)
MAX_POSITION_SIZE_PCT=0.05   # 5% max position size
PAPER_TRADING=false          # live trading mode

# ── Cadence & Quality ──────────────────────────────────────────────────────────
RUN_CADENCE_DAYS=2           # how often the bot scans (2 = every 2 days, 7 = weekly)
RUN_HOUR_UTC=16              # 16:00 UTC = 20:00 Gulf
STRICT_QUALITY=true          # true = convert below-bar picks to NO_TRADE (frequency up, quality up)
REGIME_ENABLED=true          # true = check SPY/QQQ market regime before trading

# ── Analyst brain ──────────────────────────────────────────────────────────────
ANALYST_MODEL=claude-opus-4-8   # the trade-decision brain
ANALYST_THINKING_BUDGET=2500    # extended-thinking tokens (0 = disable thinking)
ANALYST_MAX_TOKENS=4000         # must exceed thinking budget

# ── Storage ────────────────────────────────────────────────────────────────────
DB_PATH=data/trades.db

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Dashboard ──────────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=changeme   # required — dashboard won't start without this
