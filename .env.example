# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Market Data ────────────────────────────────────────────────────────────────
POLYGON_API_KEY=
FINNHUB_API_KEY=

# ── News ───────────────────────────────────────────────────────────────────────
NEWSAPI_KEY=
MARKETAUX_API_KEY=

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # your personal chat ID or @channelname

# ── Trading Parameters ─────────────────────────────────────────────────────────
ACCOUNT_CAPITAL=650          # USD — capital you're actually deploying
RISK_PER_TRADE_PCT=0.02      # 2% risk per trade (= $13 on a $650 account)
MAX_POSITION_SIZE_PCT=0.20   # 20% ceiling — only A+ conviction picks reach it
HOLD_DAYS=5                  # target hold window (drives reachability check)
PAPER_TRADING=false          # live trading mode

# ── Cadence & Quality ──────────────────────────────────────────────────────────
RUN_CADENCE_DAYS=2           # how often the bot scans (2 = every 2 days, 7 = weekly)
RUN_HOUR_UTC=16              # 16:00 UTC = 20:00 Gulf
STRICT_QUALITY=true          # true = convert below-bar picks to NO_TRADE (frequency up, quality up)
REGIME_ENABLED=true          # true = check SPY/QQQ market regime before trading

# ── Analyst brain ──────────────────────────────────────────────────────────────
ANALYST_MODEL=claude-opus-4-8   # the trade-decision brain
ANALYST_EFFORT=high             # thinking depth: low | medium | high | max
ANALYST_MAX_TOKENS=16000        # hard output ceiling

# ── Storage ────────────────────────────────────────────────────────────────────
DB_PATH=data/trades.db

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Dashboard ──────────────────────────────────────────────────────────────────
DASHBOARD_PASSWORD=changeme   # required — dashboard won't start without this
