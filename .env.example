# ── Anthropic ──────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Market Data ────────────────────────────────────────────────────────────────
POLYGON_API_KEY=
FINNHUB_API_KEY=

# ── News ───────────────────────────────────────────────────────────────────────
NEWSAPI_KEY=
MARKETAUX_API_KEY=

# ── Telegram ───────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=            # your personal chat ID or @channelname

# ── Trading Parameters ─────────────────────────────────────────────────────────
ACCOUNT_CAPITAL=10000        # USD — your paper trading starting capital
RISK_PER_TRADE_PCT=0.01      # 1% risk per trade (= $100 on a $10k account)
MAX_POSITION_SIZE_PCT=0.05   # 5% max position size
PAPER_TRADING=true           # set to false only after 4-week paper period passes

# ── Storage ────────────────────────────────────────────────────────────────────
DB_PATH=data/trades.db

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
